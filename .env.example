# Copy to .env.local and adjust for your environment.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/varian-hmis-db"

# Hosted Postgres only: use the direct/unpooled URL for drizzle-kit migrations.
# Runtime should keep the pooled URL in DATABASE_URL.
# DIRECT_DATABASE_URL="postgresql://user:password@direct-host:5432/dbname"

APP_MODE="cloud"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Clinic-server sync (APP_MODE=clinic). The cloud stores a SHA-256 hash of the
# token in facility_sync_tokens for this facility/device pair.
# SYNC_ENABLED="true"
# CLOUD_URL="https://hmis.example.com"
# FACILITY_ID="00000000-0000-7000-8000-000000000000"
# FACILITY_SYNC_TOKEN="replace-with-a-long-random-token"
# FACILITY_DEVICE_KEY="clinic-server"
# SYNC_BATCH_SIZE="100"
# SYNC_POLL_MS="10000"
# SYNC_PULL_MS="300000"
# SYNC_TIMEOUT_MS="10000"

# Set to "off" only for an automated test server. Better Auth limits /sign-in
# to 3 attempts per 10s in production; the Playwright suite signs in as six
# roles back to back and would trip it. Never set this in production.
# AUTH_RATE_LIMIT="off"

# Deployment-only docker-compose.yml settings
POSTGRES_DB="varian-hmis"
POSTGRES_USER="varian"
POSTGRES_PASSWORD="replace-with-a-strong-password"
POSTGRES_PORT="5432"
