# Thika branch node (clinic write authority). Copy to deploy/.env.thika.
# FACILITY_ID and FACILITY_SYNC_TOKEN come from `npm run provision:branches` on HQ.

BRANCH_CONTAINER_PREFIX=varian-thika
BRANCH_ENV_FILE=.env.thika
BRANCH_HTTPS_PORT=443
BRANCH_HTTP_PORT=80

POSTGRES_DB=varian-hmis
POSTGRES_USER=varian
POSTGRES_PASSWORD=replace-with-a-strong-password

APP_MODE=clinic
BETTER_AUTH_URL=https://hmis.local
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

SEED_FACILITY_CODE=THK
SEED_FACILITY_NAME=Varian HMIS Thika Branch
SEED_BRANCH_CODE=MAIN
SEED_BRANCH_NAME=Main Branch
# Must match the THK MAIN branchId printed by provision:branches on HQ.
SEED_BRANCH_ID=replace-with-thika-main-branch-id
SEED_COUNTY=Kiambu
# Must match the THK facilityId printed by provision:branches on HQ. It
# defaults to FACILITY_ID below, so normally both lines carry the same value.
SEED_FACILITY_ID=replace-with-thk-facility-id

SYNC_ENABLED=true
CLOUD_URL=https://hmis.example.com
FACILITY_ID=replace-with-thk-facility-id
FACILITY_SYNC_TOKEN=replace-with-thk-sync-token
FACILITY_DEVICE_KEY=clinic-server
# Smaller batches plus a longer per-request timeout avoid aborting large
# catch-up pushes on constrained branch links. The cloud endpoint caps at 100.
SYNC_BATCH_SIZE=50
SYNC_POLL_MS=10000
SYNC_PULL_MS=300000
SYNC_TIMEOUT_MS=60000
