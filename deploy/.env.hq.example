# Nairobi HQ (cloud write authority). Copy to deploy/.env.hq and fill secrets.
# Cloudflare Tunnel is the only ingress; do not publish the app port publicly.

POSTGRES_DB=varian-hmis
POSTGRES_USER=varian
POSTGRES_PASSWORD=replace-with-a-strong-password

APP_MODE=cloud
BETTER_AUTH_URL=https://hmis.example.com
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Cloudflare Tunnel instance to run (config and credentials live in deploy/cloudflared/).
TUNNEL_ID=replace-with-cloudflare-tunnel-id

# KRA eTIMS stays in sandbox until the operator switch is completed.
# ETIMS_ALLOW_PRODUCTION=true
# ETIMS_PRODUCTION_BASE_URL=https://etims.kra.go.ke/...
# ETIMS_PRODUCTION_API_KEY=server-secret-store-only
